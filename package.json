{
  "name": "unocss-variants",
  "type": "module",
  "version": "1.4.0",
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/praburangki/unocss-variants"
  },
  "bugs": {
    "url": "https://github.com/praburangki/unocss-variants/issues"
  },
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --config .config/tsdown.config.ts --watch",
    "build": "tsdown --config .config/tsdown.config.ts",
    "typecheck": "tsc --noEmit && pnpm typecheck:types",
    "typecheck:types": "tsc -p .config/tsconfig.type-tests.json",
    "release": "bumpp -r",
    "benchmark": "pnpm build && node benchmark/run.mjs",
    "test": "vitest run --config .config/vitest.config.ts",
    "test:watch": "vitest --config .config/vitest.config.ts",
    "update:deps": "pnpx taze major -wIrl"
  },
  "dependencies": {
    "@vinicunca/perkakas": "^1.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "@vinicunca/eslint-config": "^5.6.1",
    "bumpp": "^12.2.3",
    "eslint": "^10.9.1",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unocss": "^66.9.2",
    "vitest": "^4.1.11"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
